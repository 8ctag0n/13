# ZyberLink / ZyberLink - Gitignore

# ============================================
# Rust / Cargo
# ============================================

# Compiled files
target/
**/*.rs.bk
*.pdb

# Cargo lock file (keep for applications, ignore for libraries)
# Uncomment if this is a library:
# Cargo.lock

# Cargo build artifacts
*.so
*.dylib
*.dll
*.rlib

# Cargo local config
.cargo/config.toml

# ============================================
# Solana
# ============================================

# Solana CLI local config
.config/

# Deployed program artifacts
*.so
deploy/
dist/

# Solana test validator ledger
test-ledger/
ledger/

# Solana keypairs (CRITICAL - never commit!)
*.json
!package.json
!tsconfig.json
!vercel.json
deploy-keypair.json
id.json
keypair.json
*-keypair.json

# Program keys (keep public keys, exclude secret keys)
program-keypair.json
authority-keypair.json
payer-keypair.json
internal

# IntelliJ related
zyberlink-wallet/*.iml
zyberlink-wallet/*.ipr
zyberlink-wallet/*.iws
zyberlink-wallet/.idea/

# ============================================
# Rust FFI Bridge
# ============================================

# Generated FFI bindings
zyberlink-wallet/lib/bridge_generated.dart
zyberlink-wallet/rust/target/

