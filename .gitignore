# ============================================
# Zcash / ZK Proving
# ============================================

# Proving and verifying keys (large files, don't commit)
*.pk
*.vk
*.params
proving-keys/
verification-keys/

# But allow .gitkeep in empty directories
!.gitkeep

# Generated proofs (examples only)
proofs/
*.proof

# Witness files (sensitive data)
*.witness

# ============================================
# Prover Node
# ============================================

# Prover node runtime data
src/prover-node/runtime/
src/prover-node/jobs/
src/prover-node/state/

# Prover configuration (may contain sensitive data)
src/prover-node/config.local.toml

