{
  "name": "@zyberlink/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for ZyberLink - Privacy-preserving FHE computation on Solana",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "zyberlink",
    "fhe",
    "solana",
    "privacy",
    "homomorphic-encryption",
    "web3"
  ],
  "author": "ZyberLink Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyberlink/sdk"
  },
  "dependencies": {
    "@solana/kit": "^2.1.0",
    "@solana-program/system": "^0.7.0",
    "@solana-program/compute-budget": "^0.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "tsup": "^8.0.1",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0",
    "eslint": "^8.55.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0"
  },
  "engines": {
    "node": ">=18"
  }
}
