# ZyberLink Environment Variables
# ================================
# Copiar a .env y ajustar valores
#
# Uso:
#   cp .env.example .env
#   docker-compose up -d          # Levantar stack
#   docker-compose logs -f        # Ver logs
#   docker-compose down           # Parar todo
#   docker-compose up --scale backend=4  # Escalar

# ===========================================
# Database
# ===========================================
DB_PASSWORD=change_this_in_production

# ===========================================
# Solana Network
# ===========================================
# Localnet:  http://localhost:8899 (requiere validator local)
# Devnet:    https://api.devnet.solana.com
# Mainnet:   https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=http://localhost:8899

# Program ID (tu programa deployado)
PROGRAM_ID=6bLbYN6makhdmkGSofQJGsQ4uSZ61NjgdDn5BVdFRNiA

# ===========================================
# Backend
# ===========================================
RUST_LOG=info

# ===========================================
# Rate Limits (nginx)
# ===========================================
# Configurable en nginx.conf:
# - General: 10 req/s
# - API: 30 req/s
# - Jobs: 2 req/s
# - Max upload: 50MB
