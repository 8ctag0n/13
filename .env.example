# ZyberLink Environment Variables
# ================================
# Copiar a .env y ajustar valores
#
# Uso:
#   cp .env.example .env
#   make dev-up       # Stack containerizado en puerto 3000
#   make dev-logs     # Ver logs
#   make dev-down     # Parar todo

# Database (interno a containers, generalmente no cambiar)
POSTGRES_DB=zyberlink
POSTGRES_USER=zyberlink
POSTGRES_PASSWORD=dev_password

# Solana RPC
# ----------
# IMPORTANTE: Para desarrollo local, necesitas un validador corriendo:
#   solana-test-validator --reset
#
# Opciones:
#   - Localnet:  http://localhost:8899 (requiere validator local)
#   - Devnet:    https://api.devnet.solana.com
#   - Mainnet:   https://api.mainnet-beta.solana.com
SOLANA_RPC_URL=http://localhost:8899

# Program ID (tu programa deployado)
PROGRAM_ID=6bLbYN6makhdmkGSofQJGsQ4uSZ61NjgdDn5BVdFRNiA

# Backend
RUST_LOG=info

# Web port (donde accedes la app)
# make dev-up expone en este puerto
WEB_PORT=3000

# Production ports (para docker-compose.prod.yml)
# WEB_PORT_SSL=443
