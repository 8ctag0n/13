# ZyberLink Environment Variables
# ================================
# Copiar a .env y ajustar valores

# Database
POSTGRES_DB=zyberlink
POSTGRES_USER=zyberlink
POSTGRES_PASSWORD=changeme_in_production

# Solana
# Para devnet: https://api.devnet.solana.com
# Para mainnet: https://api.mainnet-beta.solana.com
# Para localnet: http://host.docker.internal:8899
SOLANA_RPC_URL=https://api.devnet.solana.com
PROGRAM_ID=CypherLinkProgram11111111111111111111111111

# Backend
RUST_LOG=info

# Web ports
WEB_PORT=80
WEB_PORT_SSL=443
