# ZyberLink Frontend - Production Build
# ======================================
# Multi-stage: Build con Node, serve con Nginx

# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copiar package files
COPY package*.json ./

# Instalar dependencias
RUN npm ci

# Copiar source
COPY . .

# Build produccion
RUN npm run build

# Stage 2: Nginx para servir
FROM nginx:alpine

# Copiar build
COPY --from=builder /app/dist /usr/share/nginx/html

# Copiar config nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Crear script de inicio que reemplaza variables de entorno
RUN echo '#!/bin/sh' > /docker-entrypoint.d/40-envsubst-config.sh && \
    echo 'envsubst "\$API_URL \$SOLANA_RPC_URL" < /usr/share/nginx/html/index.html > /tmp/index.html && mv /tmp/index.html /usr/share/nginx/html/index.html' >> /docker-entrypoint.d/40-envsubst-config.sh && \
    chmod +x /docker-entrypoint.d/40-envsubst-config.sh

EXPOSE 80 443

CMD ["nginx", "-g", "daemon off;"]
