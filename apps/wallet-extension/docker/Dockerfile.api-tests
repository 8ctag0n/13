# API Test Container for ZyberLink Wallet Extension
# Lightweight container for API-only tests (no browser needed)
FROM node:20-alpine

# Install curl for healthchecks
RUN apk add --no-cache curl

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source and config
COPY e2e/api-integration.spec.ts ./e2e/
COPY playwright.api.config.ts ./
COPY tsconfig.json ./

# Default command
CMD ["npx", "playwright", "test", "--config=playwright.api.config.ts", "--reporter=list"]
